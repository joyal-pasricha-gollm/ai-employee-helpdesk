# PostgreSQL connection string for local development.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/employee_helpdesk

# Generate a unique value before enabling authentication in a real deployment.
SECRET_KEY=replace-with-a-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local AI (Ollama). Install Ollama, then run: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Seconds to wait for the model before giving up. The first request after
# starting Ollama loads the model into memory and can take about a minute.
OLLAMA_TIMEOUT_SECONDS=120
